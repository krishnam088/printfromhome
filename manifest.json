{
  "name": "Print From Home",
  "short_name": "PrintFromHome",
  "description": "India's Last Minute Printing App",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "background_color": "#F4C430",
  "theme_color": "#F4C430",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "iarc_rating_id": "e58286c1-65f5-48b4-b830-a8cd1e8605c4",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://printfromhome.onrender.com/manifest.json"
    }
  ],
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://printfromhome.onrender.com"
    }
  ],
  "categories": [
    "shopping",
    "utilities",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Print Store",
      "short_name": "Store",
      "description": "Open the Print Store to upload and print documents",
      "url": "/",
      "icons": [
        {
          "src": "/app_icon_192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    }
  ],
  "icons": [
    {
      "src": "/app_icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/app_icon_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/app_icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Print From Home Mobile Dashboard"
    },
    {
      "src": "/app_icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Print From Home Desktop Dashboard"
    }
  ]
}